#!/bin/ksh
#
# $OpenBSD: gravastar! Ahhhhh that's all kiddo.

daemon="/usr/local/bin/gravastar"

. /etc/rc.d/rc.subr

# Start privileged for the port-53 bind, then the binary drops to the
# unprivileged daemon user (drop_priv_user in gravastar.toml) and applies
# unveil+pledge. Create the account once before enabling:
#   doas useradd -c "gravastar daemon" -d /var/gravastar -s /sbin/false \
#       -w no _gravastar
# and chown its state: chown -R _gravastar /var/gravastar (the generated-
# blocklist cache dir) and chown -R _gravastar /var/log/gravastar (the
# default log dir; rcctl's rcexec sanitizes the environment, so custom
# GRAVASTAR_LOG_DIR values set in this script never reach the daemon).

rc_reload=NO
rc_bg=YES

rc_cmd $1
