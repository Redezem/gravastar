[Unit]
Description=Gravastar DNS Server
After=network.target

[Service]
Type=simple
ExecStart=/usr/local/bin/gravastar -c /etc/gravastar
Restart=on-failure
User=gravastar
Group=gravastar
# Port 53 binding without running as root:
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
RestrictSUIDSGID=true
LockPersonality=true
# Writable paths for the unprivileged service (logs + generated blocklist cache):
ReadWritePaths=/var/log/gravastar /var/lib/gravastar

[Install]
WantedBy=multi-user.target
